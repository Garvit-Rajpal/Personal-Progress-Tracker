# Server environment. Copy to .env and fill in. Never commit .env.

# Dev database. Inside docker-compose the host is `postgres`; from the host
# machine it is localhost on the published port 5433.
DATABASE_URL="postgresql://postgres:password@localhost:5433/personal_progress_assistant?schema=public"

# Dedicated test database. Required by the test suite (ADR-10, LLD_v2 §1).
# tests/setupEnv.ts overwrites DATABASE_URL with this value and refuses to run
# unless it names a *different* database whose name ends in _test.
#   docker exec ppt_postgres psql -U postgres -c "CREATE DATABASE personal_progress_assistant_test"
#   DATABASE_URL="<the _test url>" npx prisma migrate deploy
DATABASE_URL_TEST="postgresql://postgres:password@localhost:5433/personal_progress_assistant_test?schema=public"

JWT_SECRET="change_me"
JWT_REFRESH_SECRET="change_me_too"

PORT=5000
CLIENT_URL="http://localhost:3010"

# ADR-4 — every day boundary in the app is computed in this timezone, never the
# server's. The container runs in UTC; without this, "today" is wrong for the
# 5h30m between 00:00 and 05:30 IST.
USER_TIMEZONE="Asia/Kolkata"
